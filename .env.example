# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Paste the raw Supabase publishable key here.
# The application keeps the historical ANON_KEY variable name for compatibility.
# Do not paste labels, quotes, explanatory text, or translated/Chinese text.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional alias supported by the application for Supabase's newer key naming.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

WORKER_SECRET=
REDIS_URL=
